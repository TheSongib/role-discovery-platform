[Unit]
Description=JobTracker API + Frontend
After=network.target

[Service]
Type=simple
User=YOUR_USERNAME
WorkingDirectory=/home/YOUR_USERNAME/jobtracker
ExecStart=/bin/bash -c 'uvicorn api:app --host 0.0.0.0 --port 8000 & npx serve -s frontend/dist -l 5173'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
