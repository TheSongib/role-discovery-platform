#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
AWS_CONFIG_DIR="${AWS_CONFIG_DIR:-${HOME}/.aws}"

if ! command -v docker >/dev/null 2>&1; then
  echo "Docker is required by this Terraform wrapper." >&2
  exit 1
fi

if [[ ! -d "$AWS_CONFIG_DIR" ]]; then
  echo "AWS configuration directory not found: $AWS_CONFIG_DIR" >&2
  exit 1
fi

DOCKER_ARGS=(--rm -i)
if [[ -t 0 && -t 1 ]]; then
  DOCKER_ARGS+=(-t)
fi

# Preserve an explicitly selected AWS profile, including IAM Identity Center
# profiles whose cached session is stored under the mounted AWS directory.
for aws_env_name in AWS_PROFILE AWS_DEFAULT_PROFILE AWS_REGION AWS_DEFAULT_REGION; do
  if [[ -n "${!aws_env_name:-}" ]]; then
    DOCKER_ARGS+=(--env "$aws_env_name")
  fi
done

exec docker run "${DOCKER_ARGS[@]}" \
  --user "$(id -u):$(id -g)" \
  --env HOME=/tmp/terraform-user \
  --volume "$AWS_CONFIG_DIR:/tmp/terraform-user/.aws:ro" \
  --volume "$SCRIPT_DIR:/work" \
  --workdir /work \
  hashicorp/terraform:1.16.3 "$@"
