aws_region = "us-east-1"

# This fresh repository uses GitHub's immutable owner/repository ID subject.
# Override this only if deploying from a different repository.
github_oidc_subject = "repo:TheSongib@61258600/role-discovery-platform@1366373286:ref:refs/heads/*"

# If this AWS account already trusts GitHub Actions, reuse that singleton
# provider instead of trying to create a second one.
# github_oidc_provider_arn = "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com"

# Keep the origin private during the first deployment phase.
allowed_http_cidrs = []
enable_public_gateway_origin = false

# This personal application scans continuously, so the node stays online.
# Set a value of at least 60 only for an on-demand demo environment.
auto_stop_after_minutes = 0

# To test the guarded origin before enabling API Gateway access, use your /32.
# allowed_http_cidrs = ["203.0.113.10/32"]
