[Unit]
Description=JobTracker Frontend
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=__JOBTRACKER_USER__
WorkingDirectory=__JOBTRACKER_DIR__
ExecStart=/usr/bin/env npx serve -s frontend/dist -l 5173
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
